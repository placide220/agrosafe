diff --git a/firestore.rules b/firestore.rules
index 5f9cf6e..f912fbf 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -7,9 +7,11 @@ service cloud.firestore {
       allow read, write: if request.auth != null && request.auth.uid == userId;
     }
     
-    // Incident reports collection - Authenticated users can read & create their incidents
+    // Incident reports collection - a farmer may only read/write their OWN incidents.
+    // The read rule is scoped to the owner (not any authenticated user) so one
+    // farmer can never list another farmer's reports.
     match /incidents/{incidentId} {
-      allow read: if request.auth != null;
+      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
     }
